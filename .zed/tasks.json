// Zed tasks: run with the "task: spawn" command (alt-shift-t by default),
// or "task: rerun" (alt-t) to repeat the last one.
[
  {
    "label": "jSI: test fixtures",
    "command": "./gradlew",
    "args": [":checker:test", "--console=plain"],
    "cwd": "$ZED_WORKTREE_ROOT",
